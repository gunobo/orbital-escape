# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# Google Cloud Console > OAuth 클라이언트 ID (웹 애플리케이션)
# "승인된 JavaScript 원본"에 https://sg.imjemin.co.kr (로컬 테스트 시 http://localhost:5173) 추가
GOOGLE_CLIENT_ID=

# 로그인 토큰 서명용 비밀키 (운영에서는 반드시 지정, 예: openssl rand -hex 32)
JWT_SECRET=

# 로컬 개발용 임시 로그인. 운영(공개) 환경에서는 반드시 false
DEV_AUTH_ENABLED=false
