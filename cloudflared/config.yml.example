# cloudflared tunnel create orbital-escape 명령 실행 후,
# 이 파일을 config.yml 로 복사하고 <TUNNEL_ID>를 실제 터널 ID로 바꾸세요.
# 자격 증명 파일(<TUNNEL_ID>.json)도 이 디렉터리에 함께 두면 됩니다.
# (config.yml, *.json 은 .gitignore 에 의해 커밋되지 않습니다)

tunnel: <TUNNEL_ID>
credentials-file: /etc/cloudflared/<TUNNEL_ID>.json

ingress:
  - hostname: sg.imjemin.co.kr
    service: http://web:80
  - service: http_status:404
